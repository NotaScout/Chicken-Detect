"""Proper way"""
# reduce to single line
open_action = next((action for action in dev0.actions if action.name == 'open'), None)

close_action = next((action for action in dev0.actions if action.name == 'close'), None)

def main():
    Door1 = Autodoor(doorInfo=dev0)
    print(Door1.name)
    print(Door1.deviceId)
    # prints full action list (all permutations)
    #print(f'DOOR INITIAL STATE = {dev0.actions}')
    print(f'DOOR INITIAL STATE = {dev0.state.door.state}')
    if open_action:
        omlet.perform_action(open_action)
        
    if close_action:
        omlet.perform_action(close_action)


    print(f'DOOR FINAL STATE = {dev0.state.door.state}')
    '''
